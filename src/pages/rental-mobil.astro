---
import LayoutLp from '../layouts/LayoutLp.astro';
import RentalHero from '../components/LpRental/RentalHero.astro';
import RentalPainPoints from '../components/LpRental/RentalPainPoints.astro';
import RentalSocialProof from '../components/LpRental/RentalSocialProof.astro';
import RentalFitur from '../components/LpRental/RentalFitur.astro';
import RentalPaket from '../components/LpRental/RentalPaket.astro';
import RentalKontak from '../components/LpRental/RentalKontak.astro';
import LpFormOrderAdvance from '../components/LpFormOrderAdvance.astro';
---

<LayoutLp
	title="Website Rental Mobil Profesional + Iklan Google - Velocity Developer"
	description="Website rental mobil profesional + setup Google Ads mulai Rp3 juta, termasuk gratis saldo iklan Google Rp500.000."
>
	<div
		id="container"
		x-data="{
			isFormOrderOpen: false,
			openFormOrderModal() {
				if (typeof window.fbq === 'function') {
					window.fbq('track', 'AddToCart');
				}
				this.isFormOrderOpen = true;
				document.body.classList.add('overflow-hidden');
			},
			closeFormOrderModal() {
				this.isFormOrderOpen = false;
				document.body.classList.remove('overflow-hidden');
			}
		}"
		@click.capture="
			if ($event.target.closest('.cta-modal-formorder')) {
				$event.preventDefault();
				openFormOrderModal();
			}
		"
		@keydown.escape.window="closeFormOrderModal()"
	>
		<main>
			<RentalHero />
			<RentalPainPoints />
			<RentalSocialProof client:idle/>
			<RentalFitur />
			<RentalPaket />
			<RentalKontak />
		</main>

		<div
			x-cloak
			x-show="isFormOrderOpen"
			x-transition.opacity
			class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 px-4 py-6"
			role="dialog"
			aria-modal="true"
			aria-labelledby="modal-formorder-title"
			@click.self="closeFormOrderModal()"
		>
			<div
				x-show="isFormOrderOpen"
				x-transition
				class="relative w-full max-w-xl rounded-3xl bg-white p-8 shadow-2xl md:p-10"
			>
				<button
					type="button"
					class="absolute right-4 top-4 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900"
					aria-label="Tutup form order"
					@click="closeFormOrderModal()"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M6 18 18 6M6 6l12 12"
						></path>
					</svg>
				</button>

				<div id="modal-formorder-title" class="sr-only">Form Konsultasi Rental Mobil</div>
				<h3 class="font-bold text-2xl mb-6 text-slate-800">Form Konsultasi Rental Mobil</h3>
				<LpFormOrderAdvance />
			</div>
		</div>
	</div>
</LayoutLp>

<style is:global>
	[x-cloak] {
		display: none !important;
	}
</style>
