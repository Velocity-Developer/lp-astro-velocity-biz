---
import Layout from '../layouts/Layout.astro';
import LpHero from '../components/LpHero.astro';
import LpPaket from '../components/LpPaket.astro';
import LpKlien from '../components/LpKlien.astro';
import LpFaq from '../components/LpFaq.astro';
import LpContact from '../components/LpContact.astro';
---

<Layout>
	<div id="container">
		<main>
			<LpHero/>

			<div class="bg-linear-to-r from-cyan-500 to-teal-500 text-white py-10 px-6 text-center">
				<div class="mx-auto max-w-3xl xl:max-w-5xl">					
					<h2 class="text-white font-bold text-xl md:text-3xl xl:text-5xl leading-tight">
						Ada 5.000 Website aktif yang kami buat, dan 16.000 Website yang telah dibuat sejak 2009 
					</h2>
				</div>
			</div>

			<LpKlien />
			<LpPaket/>
			<LpFaq/>
			<LpContact />

		</main>
	</div>
</Layout>
