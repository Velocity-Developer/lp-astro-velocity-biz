---
import Layout from '../layouts/Layout.astro';
import harga from '../data/harga.json';
import designs from '../data/design.json';

const categories = harga.categories;
const formatRupiah = (value: number) => new Intl.NumberFormat('id-ID').format(value);
const designAssetUrls = import.meta.glob('../assets/designs/**/*.{webp,png,jpg,jpeg}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const resolveDesignImage = (image: string) => {
  if (image.startsWith('/')) return image;
  const assetKey = image.replace(/^src\/assets\//, '../assets/');
  return designAssetUrls[assetKey] || image;
};
const resolvedDesigns = Object.fromEntries(
  Object.entries(designs).map(([categoryName, packages]) => [
    categoryName,
    Object.fromEntries(
      Object.entries(packages).map(([packageName, items]) => [
        packageName,
        items.map((item) => ({
          ...item,
          image: resolveDesignImage(item.image),
        })),
      ])
    ),
  ])
);
---

<Layout title="Pesan Website" description="Pesan website sesuai kebutuhan bisnis Anda dengan mudah.">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
  <script src="https://app.sandbox.midtrans.com/snap/snap.js" data-client-key={import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY}></script>
  <main
    class="min-h-screen bg-slate-50"
    x-data={`{
      categories: ${JSON.stringify(categories)},
      designs: ${JSON.stringify(resolvedDesigns)},
      step: 0,
      loading: false,
      error: '',
      selectedCategory: null,
      selectedPackage: null,
      orderNumber: '',
      snapToken: '',
      copied: false,
      lockedCategoryFromLandingPage: false,
      form: { nama: '', no_hp: '', email: '', alamat: '', nama_usaha: '', kebutuhan: '', pilihan_desain: '', url_referensi: '', url_materi: '', pembayaran: 'Transfer Bank' },
      get packages() { return this.selectedCategory?.packages || [] },
      get total() { return this.selectedPackage?.price || 0 },
      get minStep() { return this.lockedCategoryFromLandingPage ? 1 : 0 },
      get isPortalBerita() { return this.selectedCategory?.category === 'Website Berita / Media Online' },
      get currentDesigns() { return this.designs[this.selectedCategory?.category]?.[this.selectedPackage?.name] || [] },
      formatRupiah(value) { return 'Rp ' + new Intl.NumberFormat('id-ID').format(value) },
      init() {
        this.applyPresetFromQuery();
      },
      applyPresetFromQuery() {
        const params = new URLSearchParams(window.location.search);
        const categoryName = params.get('category');
        const packageName = params.get('paket');
        const packagePrice = Number(params.get('harga') || 0);

        ['nama', 'no_hp', 'email', 'alamat', 'nama_usaha', 'kebutuhan', 'pilihan_desain', 'url_referensi', 'url_materi'].forEach((key) => {
          const value = params.get(key);
          if (value) this.form[key] = value;
        });

        if (!categoryName && !packageName) return;

        const category = this.categories.find((item) => item.category === categoryName) || this.categories.find((item) => item.category === 'Website Berita / Media Online');
        if (!category) return;

        this.selectedCategory = category;
        if (packageName) {
          this.selectedPackage = this.packages.find((item) => item.name === packageName || item.name.endsWith(packageName)) || {
            name: packageName,
            price: packagePrice,
            design: 'Paket dari landingpage',
          };
        }
        this.lockedCategoryFromLandingPage = Boolean(categoryName);
        this.step = this.selectedPackage ? 2 : 1;
      },
      selectCategory(category) { this.selectedCategory = category; this.selectedPackage = null; this.form.pilihan_desain = ''; this.step = 1 },
      selectPackage(item) { this.selectedPackage = item; this.form.pilihan_desain = '' },
      selectDesign(item) { this.form.pilihan_desain = item.name },
      previousStep() {
        if (this.step <= this.minStep) return;
        this.step--;
      },
      initEditor() {
        const editor = new Quill(this.$refs.editor, { theme: 'snow', placeholder: 'Ceritakan kebutuhan website Anda', modules: { toolbar: [['bold', 'italic', 'underline'], [{ list: 'ordered' }, { list: 'bullet' }], ['link']] } });
        editor.on('text-change', () => { this.form.kebutuhan = editor.root.innerHTML === '<p><br></p>' ? '' : editor.root.innerHTML });
      },
      nextStep() {
        if (this.step === 0 && !this.selectedCategory) return;
        if (this.step === 1 && !this.selectedPackage) return;
        if (this.step === 2 && (!$refs.form.reportValidity() || !this.form.alamat.trim())) return;
        if (this.step < 2) this.step++;
        else this.sendOrder();
      },
      payOrder() {
        if (!this.snapToken || !window.snap) return;
        window.snap.pay(this.snapToken);
      },
      async copyOrderNumber() {
        await navigator.clipboard.writeText(this.orderNumber);
        this.copied = true;
        setTimeout(() => { this.copied = false }, 1500);
      },
      async sendOrder() {
        if (!this.selectedCategory || !this.selectedPackage || this.loading) return;
        this.loading = true;
        this.error = '';
        const payload = {
          jenis_web: this.selectedCategory.category,
          paket: this.selectedPackage.name,
          harga: this.total,
          nama: this.form.nama,
          email: this.form.email,
          telepon: this.form.no_hp,
          sumber_order: window.location.host,
          datadiri_order: {
            nama: this.form.nama,
            email: this.form.email,
            alamat: this.form.alamat,
            nama_usaha: this.form.nama_usaha,
          },
          project_order: {
            kebutuhan: this.form.kebutuhan,
            pilihan_desain: this.form.pilihan_desain,
            url_referensi: this.form.url_referensi,
            url_materi: this.form.url_materi,
          },
        };
        try {
          const response = await fetch('https://new.velocitydeveloper.net/api/api/public/order-web-snap', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'Authorization': 'Bearer JEs3eipnlZxhS028J4ybcBlZzwks6ac3r0nDfmsh'
            },
            body: JSON.stringify(payload)
          });
          const result = await response.json();
          const nomor_order = result.data?.nomor_order;
          const snapToken = result.snap_token;
          if (!response.ok || !snapToken) throw new Error('Token pembayaran tidak tersedia');
          if (!window.snap) throw new Error('Pembayaran belum siap, silakan coba lagi.');
          this.orderNumber = nomor_order;
          this.snapToken = snapToken;
          window.snap.pay(snapToken, {
            onSuccess: () => console.log('Pembayaran berhasil:', nomor_order),
            onPending: () => console.log('Pembayaran menunggu:', nomor_order),
            onError: () => { this.error = 'Pembayaran gagal diproses.'; },
            onClose: () => console.log('Popup pembayaran ditutup:', nomor_order),
          });
        } catch (error) {
          this.error = error.message || 'Pesanan gagal diproses.';
        } finally {
          this.loading = false;
        }
      }
    }`}
  >

    <div class="min-h-60 md:min-h-100 bg-linear-to-tl from-blue-800 to-blue-400 px-12 pb-8 pt-30 text-white flex justify-center items-center">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="mb-3 inline-block rounded-full bg-blue-100 px-4 py-1 text-sm font-semibold text-blue-700">Mulai dari sini</span>
        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Pesan website impian Anda</h1>
        <p class="mt-3 text-slate-200">Ikuti 4 langkah singkat. Tim kami akan segera memproses pesanan Anda.</p>
      </div>
    </div>

    <div class="mx-auto max-w-6xl  px-4 py-12 sm:px-6 lg:px-8">

      <div class="grid gap-8 lg:grid-cols-[1fr_340px]">
        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-8">
          <div class="mb-8 flex items-center justify-between">
            <div class="step" :class="{ active: step === 0, done: step > 0 }"><span>1</span><small>Jenis website</small></div>
            <i></i><div class="step" :class="{ active: step === 1, done: step > 1 }"><span>2</span><small>Paket</small></div>
            <i></i><div class="step" :class="{ active: step === 2, done: step > 2 }"><span>3</span><small>Data diri</small></div>
            <i></i><div class="step" :class="{ active: step === 3 }"><span>4</span><small>Pembayaran</small></div>
          </div>

          <form id="order-form" x-ref="form" @submit.prevent="nextStep">
            <div class="panel" x-show="step === 0">
              <h2 class="text-xl font-bold text-slate-900">Pilih jenis website</h2>
              <p class="mt-1 mb-6 text-sm text-slate-500">Pilih sesuai tujuan utama website Anda.</p>
              <div class="grid gap-3 sm:grid-cols-2">
                {categories.map((category) => (
                  <button type="button" class="choice text-left" :class="{ selected: selectedCategory?.category === $el.dataset.category }" @click="selectCategory(categories.find((item) => item.category === $el.dataset.category))" data-category={category.category}>
                    <strong>{category.category}</strong><span>{category.description}</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="panel" x-show="step === 1" x-cloak>
              <h2 class="text-xl font-bold text-slate-900">Pilih paket</h2>
              <p class="mt-1 mb-6 text-sm text-slate-500">Paket tersedia untuk jenis website yang dipilih.</p>
              <div id="packages" class="grid gap-3">
                <template x-for="item in packages" :key="item.name">
                  <button type="button" class="choice text-left" :class="{ selected: selectedPackage?.name === item.name }" @click="selectPackage(item)">
                    <strong x-text="item.name"></strong><span x-text="item.design"></span><b class="mt-3 block text-blue-700" x-text="formatRupiah(item.price)"></b>
                  </button>
                </template>
              </div>
            </div>

            <div class="panel" x-show="step === 2" x-cloak>
              <h2 class="text-xl font-bold text-slate-900">Isi data Anda</h2>
              <p class="mt-1 mb-6 text-sm text-slate-500">Data ini dipakai tim kami untuk menghubungi Anda.</p>
              <div class="grid gap-4 sm:grid-cols-2">
                <label>Nama lengkap<input :required="step === 2" name="nama" placeholder="Nama Anda" x-model="form.nama" /></label>
                <label>No. WhatsApp<input :required="step === 2" name="no_hp" type="tel" placeholder="081234567890" x-model="form.no_hp" /></label>
                <label>Email<input :required="step === 2" name="email" type="email" placeholder="nama@email.com" x-model="form.email" /></label>
                <label class="sm:col-span-2">Alamat<textarea :required="step === 2" name="alamat" rows="3" placeholder="Alamat lengkap" x-model="form.alamat"></textarea></label>
                <label class="sm:col-span-2"><span x-text="isPortalBerita ? 'Nama media' : 'Nama usaha / instansi'"></span><input :required="step === 2" name="nama_usaha" :placeholder="isPortalBerita ? 'Contoh: Kabar Nusantara' : 'Contoh: CV Maju Jaya'" x-model="form.nama_usaha" /></label>
                <div x-show="isPortalBerita" x-cloak class="sm:col-span-2">
                  <div class="mb-3 flex items-end justify-between gap-3">
                    <label class="m-0">Pilihan desain</label>
                    <span class="text-xs font-semibold text-slate-500" x-text="selectedPackage?.name || ''"></span>
                  </div>
                  <input type="hidden" name="pilihan_desain" :required="step === 2 && isPortalBerita" x-model="form.pilihan_desain" />
                  <div class="grid gap-3 sm:grid-cols-2">
                    <template x-for="item in currentDesigns" :key="item.name">
                      <button type="button" class="design-choice text-left" :class="{ selected: form.pilihan_desain === item.name }" @click="selectDesign(item)">
                        <img :src="item.image" :alt="item.name" loading="lazy" />
                        <strong x-text="item.name"></strong>
                      </button>
                    </template>
                  </div>
                </div>
                <div x-show="!isPortalBerita" class="sm:col-span-2 my-2 border-t border-slate-200 pt-6">
                  <h3 class="text-lg font-bold text-slate-900">Data Projek</h3>
                </div>
                <label x-show="!isPortalBerita" class="sm:col-span-2">Catatan kebutuhan<div class="quill-editor-container"><div x-ref="editor" x-init="initEditor()" class="quill-editor" style="height: 16rem; overflow-y: auto;"></div></div><input type="hidden" name="kebutuhan" :value="form.kebutuhan" /></label>
                <label x-show="!isPortalBerita">URL referensi<input name="url_referensi" type="url" placeholder="https://contoh.com" x-model="form.url_referensi" /></label>
                <label x-show="!isPortalBerita">URL materi<input name="url_materi" type="url" placeholder="https://drive.google.com/..." x-model="form.url_materi" /></label>
              </div>
            </div>


            <p x-show="error" x-text="error" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"></p>
            <div class="mt-8 flex justify-between gap-3 border-t border-slate-100 pt-6">
              <button type="button" class="rounded-full border border-slate-300 px-6 py-3 font-semibold text-slate-700" x-show="step > minStep" @click="previousStep">Kembali</button>
              <button type="button" class="ml-auto rounded-full bg-blue-600 px-7 py-3 font-semibold text-white transition hover:bg-blue-700" @click="nextStep" x-text="loading ? 'Memproses...' : (step === 2 ? 'Lanjut ke pembayaran' : 'Lanjut')"></button>
            </div>
          </form>
                    
          <div x-show="orderNumber" x-cloak class="mb-8 rounded-xl bg-emerald-50 p-5 text-emerald-900" role="status">
            <h2 class="text-xl font-bold">Terima kasih atas pesanan Anda.</h2>
            <p class="mt-2 text-sm">Selesaikan pembayaran melalui popup Midtrans.</p>
            <div class="mt-4 flex items-center gap-2 rounded-lg bg-white p-3 ring-1 ring-emerald-200">
              <strong class="flex-1 select-all" x-text="orderNumber"></strong>
              <button type="button" class="rounded-lg bg-emerald-600 px-3 py-2 text-sm font-semibold text-white" @click="copyOrderNumber" x-text="copied ? 'Tersalin' : 'Salin'"></button>
            </div>
            <button type="button" class="mt-3 w-full rounded-lg bg-blue-600 px-4 py-3 font-bold text-white hover:bg-blue-700" @click="payOrder">BAYAR</button>
          </div>
        </section>

        <aside class="h-fit rounded-2xl bg-slate-900 p-6 text-white lg:sticky lg:top-6">
          <p class="text-sm font-semibold text-blue-300">Ringkasan pesanan</p>
          <div class="mt-8 space-y-4 text-sm"><div><span class="text-slate-400">Jenis website</span><strong class="mt-1 block" x-text="selectedCategory?.category || 'Belum dipilih'"></strong></div><div><span class="text-slate-400">Paket</span><strong class="mt-1 block" x-text="selectedPackage?.name || 'Belum dipilih'"></strong></div><div class="border-t border-slate-700 pt-4"><span class="text-slate-400">Total mulai dari</span><strong class="mt-1 block text-2xl text-blue-300" x-text="formatRupiah(total)"></strong></div></div>
        </aside>
      </div>
    </div>
  </main>
</Layout>

<style>
  .quill-editor-container { margin-top: .4rem; overflow: hidden; border-radius: .65rem; }
  .quill-editor { min-height: 16rem; background: white; color: #0f172a; font-weight: 400; }
  .quill-editor .ql-editor { min-height: 16rem; }
  .step { display:flex; flex-direction:column; align-items:center; gap:.4rem; color:#94a3b8; min-width:3rem }.step span { display:grid; place-items:center; width:2rem; height:2rem; border-radius:999px; background:#e2e8f0; font-size:.875rem; font-weight:700 }.step small { font-size:.7rem; white-space:nowrap }.step.active { color:#2563eb }.step.active span { background:#2563eb; color:white }.step.done span { background:#dbeafe; color:#2563eb } .step.done { color:#2563eb } .step + i { height:1px; flex:1; margin:0 .35rem; background:#e2e8f0 }
  .design-choice { overflow:hidden; border:1px solid #e2e8f0; border-radius:1rem; background:white; transition:.2s }.design-choice:hover,.design-choice.selected { border-color:#2563eb; background:#eff6ff }.design-choice img { display:block; width:100%; height:18rem; object-fit:contain; background:#f8fafc }.design-choice strong { display:block; padding:.85rem; color:#0f172a; font-size:.875rem }
  .choice { border:1px solid #e2e8f0; border-radius:1rem; padding:1rem; transition:.2s }.choice:hover,.choice.selected { border-color:#2563eb; background:#eff6ff }.choice strong,.choice span { display:block }.choice span { margin-top:.4rem; color:#64748b; font-size:.75rem; line-height:1.5 } label { display:block; color:#475569; font-size:.875rem; font-weight:600 } input:not([type=radio]),textarea,select { display:block; width:100%; margin-top:.4rem; border:1px solid #cbd5e1; border-radius:.65rem; padding:.75rem; font:inherit; font-weight:400; outline:none; background:white } input:focus,textarea:focus,select:focus { border-color:#2563eb; box-shadow:0 0 0 3px #dbeafe }.payment { display:flex; gap:.75rem; align-items:flex-start; border:1px solid #e2e8f0; border-radius:1rem; padding:1rem; margin-bottom:.75rem; cursor:pointer }.payment:has(input:checked) { border-color:#2563eb; background:#eff6ff }.payment strong,.payment small { display:block }.payment small { margin-top:.3rem; color:#64748b; font-weight:400 }
</style>

<style is:global>
  [x-cloak] { display: none !important; }
</style>
