---
import LayoutLp from '../layouts/LayoutLp.astro';
import PaketBeritaHero from '../components/paketBerita/PaketBeritaHero.astro';
import PaketBeritaPainPoints from '../components/paketBerita/PaketBeritaPainPoints.astro';
import PaketBeritaFitur from '../components/paketBerita/PaketBeritaFitur.astro';
import BeritaPorto from '../components/portalBerita/BeritaPorto.astro';
import LpKlien from '../components/LpKlien.astro';
import PaketBeritaPilihan from '../components/paketBerita/PaketBeritaPilihan.astro';
import PaketBeritaFaq from '../components/paketBerita/PaketBeritaFaq.astro';
import PaketBeritaKontak from '../components/paketBerita/PaketBeritaKontak.astro';
---

<LayoutLp
	title="Paket Portal Berita Mulai Rp 390rb - Velocity Developer"
	description="Buat portal berita profesional mulai Rp 390rb. Tersedia Paket Biasa, Custom, dan Unlimited."
>
	<div id="container">
		<main>
			<PaketBeritaHero />
			<PaketBeritaPainPoints />
			<PaketBeritaFitur />
			<BeritaPorto client:idle />

			<div class="bg-blue-800 px-8 py-15 text-center text-white">
				<div class="mx-auto max-w-4xl xl:max-w-5xl">
					<h2 class="text-3xl font-bold leading-tight text-white md:text-5xl">
						Ada <span class="text-yellow-400">5.000 Website</span> Aktif Yang Kami Buat,
						Termasuk Portal Berita & Media Online
					</h2>
					<p class="mt-4 text-xl text-blue-200">Pengalaman lebih dari 13 tahun dalam pembuatan website profesional</p>
				</div>
			</div>

			<LpKlien />
			<PaketBeritaPilihan />
			<PaketBeritaFaq />
			<PaketBeritaKontak />
		</main>
	</div>
</LayoutLp>

<style is:global>
	[x-cloak] {
		display: none !important;
	}
</style>
