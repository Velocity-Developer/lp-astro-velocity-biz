---
import PaketWebsiteFormOrder from './PaketWebsiteFormOrder.astro';

const items = [
	{ title: 'Gratis', caption: 'Konsultasi' },
	{ title: 'Cepat', caption: 'Respon CS' },
	{ title: 'Aman', caption: 'Terpercaya' }
];
---

<section id="kontak" class="px-10 py-15 md:py-25 bg-blue-50">
	<div class="mx-auto flex max-w-7xl flex-col gap-10 lg:flex-row lg:items-center lg:justify-between">
		<div class="max-w-2xl">
			<h2 class="mb-6 text-4xl font-bold leading-tight xl:text-5xl">
				Siap Punya Website Untuk Bisnis atau Instansi Anda?
			</h2>
			<p class="mb-8 text-lg font-medium text-slate-700 md:text-xl">
				Ceritakan kebutuhan Anda. Kami bantu rekomendasikan paket yang pas untuk web profile, portal berita, atau toko online.
			</p>
			<div class="mb-10 grid grid-cols-3 gap-4">
				{items.map((item) => (
					<div class="rounded-xl bg-white px-4 py-4 text-center shadow-md">
						<div class="mb-2 block text-2xl font-bold text-blue-700">{item.title}</div>
						<div class="text-sm text-slate-600">{item.caption}</div>
					</div>
				))}
			</div>
			<div class="flex items-center gap-3 text-slate-700">
				<span class="flex h-10 w-10 items-center justify-center rounded-full bg-green-100 text-xl font-bold text-green-700">WA</span>
				<span class="text-lg font-bold">Hubungi kami di WhatsApp sekarang.</span>
			</div>
		</div>

		<div class="w-full max-w-xl">
			<div class="w-full rounded-3xl bg-white p-8 shadow-xl">
				<h3 class="mb-6 text-2xl font-bold text-slate-800">Isi Form Konsultasi Gratis</h3>
				<PaketWebsiteFormOrder />
			</div>
		</div>
	</div>
</section>
