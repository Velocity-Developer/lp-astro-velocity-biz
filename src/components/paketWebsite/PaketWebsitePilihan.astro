---
import Button from '../LpButton.astro';

const groups = [
	{
		title: 'Paket Web Profile',
		description: 'Untuk perusahaan, kantor, sekolah, organisasi, komunitas, dan usaha yang butuh website resmi.',
		packages: [
			[' Starter', 'Rp 390.000', 'Desain disediakan', 'Cocok untuk website profil sederhana.', ['Hosting 150mb', 'Gratis domain', 'Halaman profil siap online', 'Tampilan responsif', 'Dashboard admin', 'Support teknis']],
			[' Basic', 'Rp 500.000', 'Desain disediakan', 'Ruang konten lebih lengkap untuk profil usaha atau instansi.', ['Hosting 150mb', 'Gratis domain', 'Halaman profil dan layanan', 'Tampilan responsif', 'Dashboard admin', 'Support teknis']],
			[' Custom', 'Rp 1.200.000', 'Bisa ajukan desain sendiri', 'Tampilan dibuat lebih profesional sesuai kebutuhan brand.', ['Hosting 250mb', 'Gratis domain', 'Desain custom', 'Struktur halaman custom', 'SEO dasar', 'Support teknis']],
			[' Unlimited', 'Rp 3.000.000', 'Bisa ajukan desain sendiri', 'Untuk profil bisnis dengan kapasitas lebih besar dan desain premium.', ['Hosting unlimited', 'Gratis domain', 'Desain custom profesional', 'Struktur halaman custom', 'SEO dasar', 'Support teknis']]
		]
	},
	{
		title: 'Paket Web Berita',
		description: 'Untuk portal berita, media online, majalah digital, dan publikasi yang ingin rutin update artikel.',
		packages: [
			[' Paket Biasa', 'Rp 390.000', 'Desain disediakan', 'Pilihan hemat untuk mulai membangun portal berita dan publikasi online.', ['Hosting 150mb', 'Gratis domain', 'Portal berita siap online', 'Tampilan responsif', 'Dashboard mudah dikelola', 'Support teknis', 'Desain disediakan siap pakai']],
			[' Paket Custom', 'Rp 1.200.000', 'Bisa ajukan desain sendiri', 'Cocok untuk portal berita dengan tampilan dan kebutuhan yang lebih khusus.', ['Hosting 250mb', 'Gratis domain', 'Tampilan responsif', 'Dashboard mudah dikelola', 'Desain custom', 'Struktur kategori custom', 'Optimasi SEO dasar']],
			[' Paket Unlimited', 'Rp 3.000.000', 'Bisa ajukan desain sendiri', 'Solusi lengkap untuk media online yang ingin berkembang tanpa khawatir batasan.', ['Hosting unlimited', 'Gratis domain', 'Tampilan responsif', 'Dashboard mudah dikelola', 'Desain custom', 'Struktur kategori custom', 'Optimasi SEO dasar']]
		]
	},
	{
		title: 'Paket Web Toko Online',
		description: 'Untuk pemilik usaha yang ingin menampilkan katalog produk, menerima order, dan terlihat lebih profesional.',
		packages: [
			[' Starter', 'Rp 390.000', 'Desain disediakan', 'Cocok untuk katalog produk sederhana.', ['Hosting 150mb', 'Gratis domain', 'Katalog produk', 'Tampilan responsif', 'Dashboard admin', 'Support teknis']],
			[' Custom', 'Rp 1.200.000', 'Bisa ajukan desain sendiri', 'Tampilan toko dibuat lebih profesional.', ['Hosting 250mb', 'Gratis domain', 'Desain custom', 'Katalog produk', 'Struktur kategori produk', 'Support teknis']],
			[' Unlimited', 'Rp 3.000.000', 'Bisa ajukan desain sendiri', 'Untuk toko online dengan kapasitas lebih besar dan kebutuhan premium.', ['Hosting unlimited', 'Gratis domain', 'Desain custom profesional', 'Katalog produk', 'Struktur kategori produk', 'Support teknis']]
		]
	}
];
---

<section id="paketweb" class="bg-linear-to-r from-blue-800 to-sky-600 px-6 py-20 text-white md:px-10">
	<div class="mx-auto max-w-7xl">
		<div class="mx-auto max-w-3xl text-center">
			<div class="mb-3 inline-flex rounded-full bg-white/15 px-4 py-2 text-sm font-semibold text-yellow-200">Paket Website</div>
			<h2 class="text-3xl font-bold md:text-5xl">Pilih Paket Sesuai Kebutuhan</h2>
			<p class="mt-4 text-lg leading-8 text-blue-100">
				Paket Rp 390rb dan Rp 500rb menggunakan desain yang sudah disediakan. Paket Rp 1,2jt dan Rp 3jt unlimited bisa mengajukan desain sendiri dengan hasil lebih profesional.
			</p>
		</div>

		<div class="mt-12 space-y-8">
			{groups.map((group) => (
				<div class="rounded-3xl border border-white/20 bg-white/10 p-5 shadow-xl backdrop-blur-sm md:p-8">
					<div class="mb-6 flex flex-col gap-3 border-b border-white/20 pb-6 lg:flex-row lg:items-end lg:justify-between">
						<div class="max-w-3xl">
							<h3 class="text-2xl font-bold text-yellow-300 md:text-4xl">{group.title}</h3>
							<p class="mt-3 leading-7 text-blue-100 md:text-lg">{group.description}</p>
						</div>
					</div>
					<div class:list={['grid gap-5', group.packages.length === 4 ? 'md:grid-cols-4' : 'md:grid-cols-3']}>
						{group.packages.map(([name, price, design, description, features], index) => (
							<article class:list={[
								'relative flex h-full flex-col rounded-2xl border p-5 shadow-xl transition-shadow hover:shadow-2xl xl:p-5',
								index === 1 ? 'border-yellow-300 bg-white text-slate-900' : 'border-white/20 bg-white/10 text-white'
							]}>
								{index === 1 && (
									<div class="absolute right-4 top-4 rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-slate-900">
										Rekomendasi
									</div>
								)}
								<div class="pr-24">
									<h4 class:list={['text-xl font-bold', index === 1 ? 'text-blue-800' : 'text-yellow-200']}>{name}</h4>
									<div class:list={['mt-3 text-3xl font-extrabold tracking-tight', index === 1 ? 'text-slate-900' : 'text-yellow-400']}>{price}</div>
								</div>
								<div class:list={[
									'mt-4 inline-flex w-fit whitespace-nowrap rounded-full px-3 py-1 text-xs font-bold',
									design === 'Desain disediakan'
										? index === 1 ? 'bg-slate-100 text-slate-700' : 'bg-white/15 text-blue-50'
										: index === 1 ? 'bg-green-100 text-green-800' : 'bg-green-400/20 text-green-100'
								]}>
									{design}
								</div>
								<p class:list={['mt-4 min-h-16 leading-7', index === 1 ? 'text-slate-600' : 'text-blue-100']}>{description}</p>
								<ul class="my-6 grid gap-3">
									{features.map((feature) => (
										<li class="flex items-start gap-3">
											<span class:list={['mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-bold', index === 1 ? 'bg-blue-100 text-blue-700' : 'bg-white/15 text-yellow-300']}>&check;</span>
											<span class:list={['text-sm leading-6 md:text-base', index === 1 ? 'text-slate-700' : 'text-blue-50']}>{feature}</span>
										</li>
									))}
								</ul>
								<div class="mt-auto">
									<Button link="#" className="cta-modal-formorder w-full px-6 py-4 text-base font-bold shadow-lg" color="yellow" onclick="if (typeof window.fbq === 'function') window.fbq('track', 'AddToCart');">
										Pilih {group.title.replace('Paket ', '')} {name}
									</Button>
								</div>
							</article>
						))}
					</div>
				</div>
			))}
		</div>
	</div>
</section>
