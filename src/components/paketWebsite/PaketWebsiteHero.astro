---
import Button from '../LpButton.astro';

const runningItems = [
	'Web profile perusahaan',
	'Website sekolah dan organisasi',
	'Portal berita',
	'Toko online',
	'Gratis konsultasi kebutuhan'
];
---

<section id="hero" class="relative isolate w-full overflow-hidden bg-linear-to-r from-blue-800 to-sky-600 px-6 pt-30 text-white md:px-10 md:pb-10 md:pt-20 xl:px-0">
	<div class="absolute inset-0 -z-10 opacity-25" style="background-image:linear-gradient(to right, #e7e5e4 1px, transparent 1px),linear-gradient(to bottom, #e7e5e4 1px, transparent 1px);background-size:20px 20px;mask-image:radial-gradient(ellipse 80% 80% at 100% 0%, #000 50%, transparent 90%);"></div>
	<div class="absolute inset-0 -z-10 bg-blue-950/20"></div>
	<div class="relative z-10 mx-auto flex min-h-[25em] max-w-7xl items-center justify-center md:min-h-[40em]">
		<div class="mx-auto max-w-5xl space-y-6 text-center">
			<div class="inline-flex rounded-full border border-white/40 bg-white/15 px-5 py-2 text-sm font-semibold text-white shadow-sm">
				Jasa pembuatan website untuk bisnis, kantor, sekolah, media, dan toko online
			</div>
			<h1 class="text-4xl font-extrabold leading-tight text-white drop-shadow-lg md:text-6xl">
				Punya Website Profesional Mulai <span class="text-yellow-400">Rp 390rb</span>
			</h1>
			<h2 class="text-xl font-extrabold text-white drop-shadow md:text-3xl">
				Web profile, portal berita, dan toko online siap online tanpa ribet teknis.
			</h2>
			<p class="mx-auto max-w-3xl text-base leading-8 text-white/90 drop-shadow md:text-xl">
				Cocok untuk perusahaan, pemilik usaha, kantor, sekolah, organisasi, media online, sampai bisnis yang ingin mulai jualan lewat website toko online.
			</p>
			<div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<Button link="#" className="cta-modal-formorder px-10 py-4 text-lg font-bold shadow-lg hover:shadow-xl transition-shadow" color="yellow" onclick="if (typeof window.fbq === 'function') window.fbq('track', 'AddToCart');">Konsultasi Gratis via WhatsApp</Button>
				<a href="#paketweb" class="inline-flex rounded-full border border-white/40 bg-white/10 px-8 py-3 font-semibold text-white transition-colors hover:bg-white/20">Lihat Paket Website</a>
			</div>
		</div>
	</div>
	<div class="relative z-10 mx-auto max-w-7xl overflow-hidden whitespace-nowrap pb-4 text-white md:pb-0">
		<div class="marquee-container overflow-hidden">
			<div class="marquee-track flex text-sm md:text-lg">
				{Array.from({ length: 2 }).map(() => <div class="marquee-content flex">{runningItems.map((item) => <div class="mr-6 flex items-center gap-2 opacity-80 md:mr-10"><span class="text-yellow-300">&check;</span>{item}</div>)}</div>)}
			</div>
		</div>
	</div>
</section>
