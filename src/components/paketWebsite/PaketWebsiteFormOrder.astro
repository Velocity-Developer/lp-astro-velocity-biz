---
const fields = [
	{ label: 'Nama', name: 'nama', type: 'text', placeholder: 'Nama Anda' },
	{ label: 'No. HP / WhatsApp', name: 'no_hp', type: 'tel', placeholder: 'Contoh: 081234567890' },
	{ label: 'Nama usaha / instansi', name: 'nama_usaha', type: 'text', placeholder: 'Contoh: CV Maju Jaya' },
	{ label: 'Kebutuhan website', name: 'kebutuhan_website', type: 'text', placeholder: 'Jelaskan kebutuhan website anda' }
];

const wa = '6285600566674';
---

<form
	class="w-full"
	x-data={`{
		form: {
			jenis_web: '',
			nama: '',
			no_hp: '',
			nama_usaha: '',
			kebutuhan_website: '',
			utm_source: '',
			utm_medium: '',
			utm_campaign: '',
			utm_adset: '',
			utm_content: ''
		},
		wa: '${wa}',
		initUtm() {
			const params = new URLSearchParams(window.location.search);
			['utm_source', 'utm_medium', 'utm_campaign', 'utm_adset', 'utm_content'].forEach((key) => {
				this.form[key] = params.get(key) || '';
			});
		},
		get isValid() {
			return ['jenis_web', 'nama', 'no_hp', 'nama_usaha', 'kebutuhan_website']
				.every((key) => String(this.form[key]).trim() !== '');
		},
		get waLink() {
			const message = [
				'Halo, saya ingin konsultasi pembuatan website di Velocity Developer.',
				'',
				'Jenis web: ' + this.form.jenis_web,
				'Nama: ' + this.form.nama,
				'No. HP: ' + this.form.no_hp,
				'Nama usaha / instansi: ' + this.form.nama_usaha,
				'Kebutuhan website: ' + this.form.kebutuhan_website
			].join('\\n');

			return 'https://wa.me/' + this.wa + '?text=' + encodeURIComponent(message);
		},
		get orderPayload() {
			const utmInfo = [
				'UTM Source: ' + (this.form.utm_source || '-'),
				'UTM Medium: ' + (this.form.utm_medium || '-'),
				'UTM Campaign: ' + (this.form.utm_campaign || '-'),
				'UTM Adset: ' + (this.form.utm_adset || '-'),
				'UTM Content: ' + (this.form.utm_content || '-')
			].join('\\n');

			return {
				source: window.location.host + window.location.pathname,
				nama: this.form.nama,
				hp: this.form.no_hp,
				usia: '',
				kebutuhan: 'Jenis web: ' + this.form.jenis_web + '\\nNama usaha / instansi: ' + this.form.nama_usaha + '\\nKebutuhan website: ' + this.form.kebutuhan_website + '\\n' + utmInfo,
				utm_source: this.form.utm_source,
				utm_medium: this.form.utm_medium,
				utm_campaign: this.form.utm_campaign,
				utm_adset: this.form.utm_adset,
				utm_content: this.form.utm_content
			};
		},
		sendOrder() {
			fetch('https://new.velocitydeveloper.net/api/api/public/form-order', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'Accept': 'application/json',
					'Authorization': 'Bearer JEs3eipnlZxhS028J4ybcBlZzwks6ac3r0nDfmsh'
				},
				body: JSON.stringify(this.orderPayload)
			}).catch((error) => console.log('Form order POST error:', error));
		}
	}`}
	x-init="initUtm()"
	@submit.prevent
>
	<input type="hidden" name="utm_source" x-model="form.utm_source" />
	<input type="hidden" name="utm_medium" x-model="form.utm_medium" />
	<input type="hidden" name="utm_campaign" x-model="form.utm_campaign" />
	<input type="hidden" name="utm_adset" x-model="form.utm_adset" />
	<input type="hidden" name="utm_content" x-model="form.utm_content" />
	<h3 class="mb-6 text-lg font-bold md:text-2xl">Lengkapi data singkat</h3>
	<div class="mb-4">
		<label class="mb-1 block text-sm text-slate-600" for="jenis_web">Jenis web</label>
		<select id="jenis_web" name="jenis_web" class="w-full rounded-md border border-slate-300 bg-white p-2" x-model="form.jenis_web" required>
			<option value="" disabled>Pilih jenis web</option>
			<option value="Web Profile">Web Profile</option>
			<option value="Web Berita">Web Berita</option>
			<option value="Toko Online">Toko Online</option>
			<option value="Lainnya">Lainnya</option>
		</select>
	</div>
	{fields.map((field) => (
		<div class="mb-4">
			<label class="mb-1 block text-sm text-slate-600" for={field.name}>{field.label}</label>
			<input id={field.name} class="w-full rounded-md border border-slate-300 p-2" type={field.type} name={field.name} placeholder={field.placeholder} x-model={`form.${field.name}`} required />
		</div>
	))}
	<div class="mt-8">
		<a
			x-bind:href="isValid ? waLink : '#formorder'"
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex w-full items-center justify-center rounded-full bg-linear-to-r from-green-500 to-green-800 px-8 py-4 font-semibold text-white transition-shadow hover:shadow-md"
			x-bind:class="isValid ? 'cursor-pointer' : 'pointer-events-none cursor-not-allowed opacity-50'"
			x-bind:aria-disabled="(!isValid).toString()"
			@click="if (!isValid) { $event.preventDefault(); return; } if (typeof window.fbq === 'function') window.fbq('track', 'Lead'); sendOrder()"
		>
			Lanjut Konsultasi via WhatsApp
		</a>
	</div>
</form>
