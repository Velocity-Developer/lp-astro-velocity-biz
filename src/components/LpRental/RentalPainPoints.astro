---
import Button from '../LpButton.astro';

const painPoints = [
	'Tidak muncul di Google saat orang mencari rental mobil di kota Anda',
	'Mengandalkan relasi dan rekomendasi dari mulut ke mulut',
	'Sulit mendapatkan pelanggan baru setiap bulan',
	'Kompetitor lebih sering muncul di Google',
	'Kompetitor mendapatkan lebih banyak telepon dan WhatsApp',
	'Masih mengandalkan Facebook dan Instagram',
	'Tidak memiliki website profesional',
	'Kehilangan calon pelanggan setiap hari tanpa disadari'
];
---

<section id="masalah" class="bg-white px-6 py-16 md:py-24">
	<div class="mx-auto max-w-6xl">
		<div class="mx-auto max-w-4xl text-center">
			<p class="text-4xl mb-3 font-bold uppercase tracking-[.2em] text-orange-600">Coba cek bisnis Anda</p>
			<h2 class="text-3xl font-bold leading-tight text-slate-900 md:text-5xl">Usaha Rental Mobil Anda Punya Salah Satu Masalah Ini?</h2>
		</div>

		<div class="text-xl mt-10 grid gap-4 md:grid-cols-2">
			{painPoints.map((pain) => (
				<div class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-1 hover:border-orange-300 hover:shadow-lg">
					<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-rose-100 font-bold text-rose-600">×</div>
					<p class="pt-2 font-semibold leading-relaxed text-slate-700">{pain}</p>
				</div>
			))}
		</div>

		<div class="mt-12 rounded-3xl bg-slate-900 px-6 py-10 text-center text-white shadow-2xl md:px-12">
			<p class="mx-auto max-w-4xl text-4xl font-bold leading-relaxed md:text-4xl">
				Hanya dengan <span class="text-5xl text-yellow-300">Rp 2 Juta.</span> Kami bantu mengatasinya dengan <span class="text-yellow-300">website profesional dan setup iklan Google</span>
			</p>
			<p class="mt-4 text-lg text-slate-300">Termasuk GRATIS saldo iklan senilai <strong class="text-white text-4xl">Rp500.000</strong>.</p>
			<div class="mt-7">
				<Button link="#" className="cta-modal-formorder px-10 py-4 text-base font-bold" color="yellow">Saya Ingin Bisnis Saya Muncul di Google</Button>
			</div>
		</div>
	</div>
</section>
