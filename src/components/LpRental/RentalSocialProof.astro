---
import { Image } from 'astro:assets';
import Button from '../LpButton.astro';
import portfolioOne from '../../assets/porto/letsexploreindonesia.com.webp';
import portfolioTwo from '../../assets/porto/fahmitour.com.webp';
import portfolioThree from '../../assets/porto/primadutatour.com.webp';

const portfolio = [
	{ title: 'Website katalog armada', caption: 'Tampilan layanan yang rapi dan mudah dipahami', image: portfolioOne },
	{ title: 'Website pemesanan perjalanan', caption: 'Informasi paket dan kontak tampil lebih meyakinkan', image: portfolioTwo },
	{ title: 'Website travel profesional', caption: 'Desain responsif untuk calon pelanggan mobile', image: portfolioThree }
];


import ImgPortoIklan1 from '../../assets/rental-mobil/iklan-google/porto iklan 1.png';
import ImgPortoIklan2 from '../../assets/rental-mobil/iklan-google/porto iklan 2.png';
import ImgPortoIklan3 from '../../assets/rental-mobil/iklan-google/porto iklan 3.png';

const portoIklan = [
	{ image: ImgPortoIklan1 },
	{ image: ImgPortoIklan2 },
	{ image: ImgPortoIklan3 }
]


import ImgglobalrentalmobilCom from '../../assets/rental-mobil/globalrentalmobil.com.webp';
import ImgmitrawisatatransCom from '../../assets/rental-mobil/mitrawisatatrans.com.webp';
import ImgtransjayaCom from '../../assets/rental-mobil/transjaya.com.webp';
import ImgberkahkawanrentalmobilCom from '../../assets/rental-mobil/berkahkawanrentalmobil.com.webp';
import ImgkharismatransportjogjaCom from '../../assets/rental-mobil/kharismatransportjogja.com.webp';
import ImgqueenjayarentalCom from '../../assets/rental-mobil/queenjayarental.com.webp';
import ImgsewabusbekasiCom from '../../assets/rental-mobil/sewabusbekasi.com.webp';
const itemsSwiper = [
    {
        title: 'globalrentalmobil.com',
        image: ImgglobalrentalmobilCom
    },
    {
        title: 'mitrawisatatrans.com',
        image: ImgmitrawisatatransCom
    },
    {
        title: 'transjaya.com',
        image: ImgtransjayaCom
    },
    {
        title: 'berkahkawanrentalmobil.com',
        image: ImgberkahkawanrentalmobilCom
    },
	{
        title: 'kharismatransportjogja.com',
        image: ImgkharismatransportjogjaCom
    },
	{
        title: 'queenjayarental.com',
        image: ImgqueenjayarentalCom
    },
    {
        title: 'sewabusbekasi.com',
        image: ImgsewabusbekasiCom
    }
]
---

<section id="review" class="overflow-hidden bg-slate-950 px-6 py-16 text-white md:py-24">
	<div class="mx-auto max-w-6xl">

		<div class="text-center mb-9">
			<p class="font-bold uppercase tracking-[.2em] text-orange-400">Ditemukan saat pelanggan mencari</p>
			<h2 class="mt-3 text-3xl font-bold leading-tight md:text-5xl">Sudah Banyak Klien Kami yang Websitenya Muncul di Halaman Pertama Google</h2>
			<p class="mt-5 text-lg leading-relaxed text-slate-300">Website yang profesional memberi bisnis Anda tempat untuk ditemukan, menjelaskan layanan, menampilkan armada, dan mengarahkan calon pelanggan ke WhatsApp.</p>
			<div class="mt-7">
				<Button link="#" className="cta-modal-formorder px-9 py-4 font-bold" color="yellow">Bantu Website Saya Tampil di Google</Button>
			</div>
		</div>

		<div class="relative flex w-full snap-x snap-mandatory gap-2 overflow-x-auto pb-14">		
			{portoIklan.map((item) => (
				<div class="shrink-0 snap-center">
					<Image src={item.image} alt="porto iklan google" class="bg-white w-80 md:w-150 shrink-0 rounded-lg" loading="lazy" />
				</div>
			))}
		</div>

	</div>
</section>

<section id="porto" class="bg-white px-6 py-16 md:py-24">

	<div class="mx-auto max-w-7xl">
		<div class="mx-auto max-w-4xl text-center mb-20">
			<p class="font-bold uppercase tracking-[.2em] text-blue-600">Tampil profesional, lebih dipercaya</p>
			<h2 class="mt-3 text-3xl font-bold leading-tight text-slate-900 md:text-5xl">Dengan Tampilan Website Profesional, Customer Akan Lebih Percaya dengan Jasa Anda</h2>
			<p class="mt-5 text-lg text-slate-600">Berikut contoh kualitas website bisnis transportasi dan perjalanan yang telah kami kerjakan.</p>
		</div>

		
		<div class="swiper mySwiper" data-rental-swiper-root>
			<div class="swiper-wrapper">
			{itemsSwiper.map((item, index) => (
				<div class="swiper-slide pb-2">
					<div class="carousel-cell-container relative">
						<Image src={item.image} alt={item.title} loading="lazy" class="w-full object-contain shadow-md"/>
						<div class="caption absolute bottom-0 left-0 right-0 pb-1 px-1 text-center text-sm transition-all duration-300">                        
							<div class="bg-blue-600 rounded-full text-white p-2 shadow-md">
								{item.title}
							</div>
						</div>
					</div>
				</div>
			))}
		</div>

	</div>
</section>

<script>
    const root = document.querySelector<HTMLDivElement>('[data-rental-swiper-root]');
    const swiperElement = root;

    async function initSwiper() {
        if (!root || !swiperElement || root.dataset.swiperInitialized === 'true') {
            return;
        }

        root.dataset.swiperInitialized = 'true';

        const [{ default: Swiper }, { Autoplay, EffectCoverflow }] = await Promise.all([
            import('swiper'),
            import('swiper/modules'),
        ]);

        new Swiper(swiperElement, {
            modules: [Autoplay, EffectCoverflow],
            effect: 'coverflow',
            grabCursor: false,
            centeredSlides: true,
            slidesPerView: 1.15,
            spaceBetween: 16,
            coverflowEffect: {
                rotate: 0,
                stretch: 0,
                depth: 120,
                modifier: 1,
                slideShadows: true,
                scale: 0.92,
            },
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
                pauseOnMouseEnter: true,
            },
            loop: true,
            breakpoints: {
                640: {
                    slidesPerView: 2,
                    spaceBetween: 16,
                    coverflowEffect: {
                        depth: 160,
                    },
                },
                768: {
                    slidesPerView: 3,
                    spaceBetween: 24,
                    coverflowEffect: {
                        depth: 240,
                    },
                },
            },
        });

        root.dataset.swiperReady = 'true';
    }

    if (root && swiperElement) {
        const observer = new IntersectionObserver((entries) => {
            const [entry] = entries;

            if (!entry?.isIntersecting) {
                return;
            }

            observer.disconnect();
            initSwiper().catch(() => {
                root.dataset.swiperInitialized = 'false';
            });
        }, {
            rootMargin: '300px 0px',
        });

        observer.observe(root);
    }
</script>

<style>
    .mySwiper {
        overflow-x: auto;
        padding-block: 1rem;
        scrollbar-width: none;
    }

    .mySwiper::-webkit-scrollbar {
        display: none;
    }

    .mySwiper .swiper-wrapper {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(82%, 1fr);
        gap: 1rem;
        align-items: center;
        scroll-snap-type: x mandatory;
    }

    .mySwiper .swiper-slide {
        scroll-snap-align: center;
    }

    .mySwiper .caption {
        opacity: 1;
        transform: translateY(0);
    }

    .mySwiper img {
        filter: none;
    }

    [data-swiper-ready="true"].mySwiper:not(.swiper-coverflow.swiper-3d) {
        opacity: 0;
    }

    [data-swiper-ready="true"].mySwiper {
        overflow: hidden;
        padding-block: 0;
    }

    [data-swiper-ready="true"].mySwiper .swiper-wrapper {
        display: flex;
        gap: 0;
        align-items: stretch;
        scroll-snap-type: none;
        transition-property: transform;
        box-sizing: content-box;
    }

    [data-swiper-ready="true"].mySwiper .swiper-slide {
        flex-shrink: 0;
        width: 100%;
        height: 100%;
        position: relative;
        transition-property: transform;
        display: block;
        scroll-snap-align: unset;
    }

    [data-swiper-ready="true"].mySwiper.swiper-3d {
        perspective: 1200px;
    }

    [data-swiper-ready="true"].mySwiper.swiper-3d .swiper-wrapper {
        transform-style: preserve-3d;
    }

    [data-swiper-ready="true"].mySwiper.swiper-3d .swiper-slide,
    [data-swiper-ready="true"].mySwiper.swiper-3d .swiper-slide-shadow-left,
    [data-swiper-ready="true"].mySwiper.swiper-3d .swiper-slide-shadow-right {
        transform-style: preserve-3d;
    }

    [data-swiper-ready="true"].mySwiper .swiper-slide-shadow-left,
    [data-swiper-ready="true"].mySwiper .swiper-slide-shadow-right {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 10;
    }

    [data-swiper-ready="true"].mySwiper .swiper-slide-shadow-left {
        background-image: linear-gradient(to left, rgba(0, 0, 0, 0.5), transparent);
    }

    [data-swiper-ready="true"].mySwiper .swiper-slide-shadow-right {
        background-image: linear-gradient(to right, rgba(0, 0, 0, 0.5), transparent);
    }

    [data-swiper-ready="true"].mySwiper .swiper-slide:not(.swiper-slide-active) .caption {
        opacity: 0;
        transform: translateY(150%);
    }

    [data-swiper-ready="true"].mySwiper .swiper-slide:not(.swiper-slide-active) img {
        filter: grayscale(70%);
    }

    @media screen and (min-width: 640px) {
        .mySwiper .swiper-wrapper {
            grid-auto-columns: minmax(48%, 1fr);
        }
    }

    @media screen and (min-width: 768px) {
        .mySwiper .swiper-wrapper {
            grid-auto-columns: minmax(31%, 1fr);
        }
    }
</style>
