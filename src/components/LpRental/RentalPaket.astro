---
import Button from '../LpButton.astro';

const packageBenefits = [
	'Website rental mobil profesional',
	'Setup Google Ads',
	'Optimasi iklan',
	'Gratis saldo iklan Google Rp500.000',
	'Hosting unlimited',
	'Domain gratis 1 tahun',
	'Support selalu ready via WhatsApp'
];
---

<section id="paketweb" class="overflow-hidden bg-linear-to-br from-orange-700 to-amber-600 px-4 py-14 text-white sm:px-6 md:py-24">
	<div class="mx-auto max-w-6xl">
		<div class="mx-auto max-w-4xl text-center">
			<p class="text-xs font-bold uppercase tracking-[.18em] text-orange-100 sm:text-base sm:tracking-[.2em]">Saatnya masuk ke Google</p>
			<h2 class="mt-3 text-2xl font-bold leading-tight sm:text-3xl md:text-5xl">Sudah Saatnya Jasa Rental Mobil Anda Masuk di Halaman Pertama Pencarian Google</h2>
			<p class="mt-4 text-sm leading-relaxed text-orange-50 sm:mt-5 sm:text-lg">Orang yang serius mencari jasa rental mobil akan langsung mengetik di Google. Pastikan bisnis Anda ada saat mereka mencari.</p>
		</div>

		<div class="mx-auto mt-9 max-w-3xl rounded-2xl border border-white/25 bg-slate-950 p-4 shadow-2xl sm:mt-12 sm:rounded-[2rem] sm:p-7 md:p-12">
			<div class="text-center">
				<p class="text-xs font-bold uppercase tracking-widest text-orange-300 sm:text-sm">Paket Website + Google Ads</p>
				<p class="mt-4 break-words text-4xl font-bold tracking-tight text-yellow-300 sm:mt-5 sm:text-5xl md:text-7xl">Rp3.000.000</p>
				<p class="mt-2 text-sm text-slate-300 sm:mt-3 sm:text-base">Investasi mulai dari Rp3 juta</p>
				<div class="mt-4 inline-flex max-w-full items-center justify-center rounded-full bg-green-500 px-4 py-2 text-xs font-bold leading-relaxed text-white sm:mt-5 sm:px-5 sm:text-base">Bonus saldo iklan Rp500.000</div>
			</div>

			<div class="mt-7 grid gap-2.5 sm:mt-9 sm:grid-cols-2 sm:gap-3">
				{packageBenefits.map((benefit) => (
					<div class="flex items-start gap-3 rounded-xl bg-white/5 p-3 text-sm leading-relaxed text-slate-100 sm:p-4">
						<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500 text-white">
							<svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 10 3 3 7-7"></path></svg>
						</span>
						<span class="pt-0.5">{benefit}</span>
					</div>
				))}
			</div>

			<div class="mt-7 text-center sm:mt-9">
				<Button link="#" className="cta-modal-formorder w-full px-4 py-4 text-sm font-bold shadow-xl sm:w-auto sm:px-8 sm:py-5 sm:text-lg" color="yellow">Ambil Paket & Konsultasi Gratis</Button>
				<p class="mx-auto mt-4 max-w-lg text-[11px] leading-relaxed text-slate-400 sm:text-xs">Konsultasikan kebutuhan dan target kota bisnis rental Anda bersama tim kami.</p>
			</div>
		</div>
	</div>
</section>
