---
import LpFormOrder from '../LpFormOrder.astro';

const items = [
	{
		title: '1 Menit',
		caption: 'Respon Cepat'
	},
	{
		title: 'CS Ramah',
		caption: 'Siap Membantu'
	},
	{
		title: '100% Aman',
		caption: 'Terpercaya'
	}
];
---

<section id="contact" class="px-6 py-16 md:px-10 md:py-24 bg-orange-50">
	<div class="mx-auto max-w-7xl flex flex-col lg:flex-row lg:justify-between lg:items-center gap-10">
		<div class="max-w-2xl">
			<h2 class="font-bold text-4xl xl:text-5xl mb-6">
				Siap Membuat Bisnis Rental Mobil Anda Lebih Mudah Ditemukan?
			</h2>
			<p class="text-lg md:text-xl font-medium text-slate-700 mb-8">
				Konsultasi gratis sekarang. Kami siap membuat website rental mobil profesional dan membantu setup Google Ads untuk menjangkau calon pelanggan di kota Anda.
			</p>
			<div class="grid grid-cols-3 gap-4 mb-10">
				{items.map((item) => (
					<div class="px-4 py-4 bg-white rounded-xl shadow-md text-center">
						<div class="text-2xl font-bold block mb-2 text-orange-600">
							{item.title}
						</div>
						<div class="text-sm text-slate-600">{item.caption}</div>
					</div>
				))}
			</div>
			<div class="flex items-center gap-3 text-slate-700">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-whatsapp text-green-600" viewBox="0 0 16 16">
					<path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232" />
				</svg>
				<span class="font-bold text-lg">Hubungi kami di WhatsApp sekarang!</span>
			</div>
		</div>

		<div class="max-w-xl w-full">
			<div class="bg-white p-8 rounded-3xl w-full shadow-xl">
				<h3 class="font-bold text-2xl mb-6 text-slate-800">
					Isi Form Konsultasi Gratis
				</h3>
				<LpFormOrder />
			</div>
		</div>
	</div>
</section>
