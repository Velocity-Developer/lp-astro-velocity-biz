---
import Button from '../LpButton.astro';

const featureRows = [
	['Website Rental Mobil Profesional', true, false],
	['Iklan Google Ads Setup', true, false],
	['Optimasi Iklan', true, false],
	['Hosting Unlimited', true, false],
	['Domain Gratis 1 Tahun', true, 'Kadang'],
	['Support Selalu Ready via WhatsApp', true, 'Harus buat tiket']
];
---

<section id="fitur" class="bg-orange-50 px-3 py-16 sm:px-6 md:py-24">
	<div class="mx-auto max-w-5xl">
		<p class="text-center font-bold uppercase tracking-[.2em] text-blue-800">Bandingkan sebelum memilih</p>
		<h2 class="mx-auto mt-3 max-w-3xl text-center text-3xl font-bold text-slate-900 md:text-5xl">Mengapa Memilih Velocity Developer Dibanding Jasa Lain?</h2>

		<div class="mt-10 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl md:rounded-3xl">
			<table class="w-full table-fixed border-collapse text-center">
				<colgroup>
					<col class="w-[46%]" />
					<col class="w-[27%]" />
					<col class="w-[27%]" />
				</colgroup>
				<thead>
					<tr>
						<th class="bg-slate-100 px-3 py-4 text-left text-xs text-slate-700 sm:px-5 sm:py-5 sm:text-base">Fitur</th>
						<th class="wrap-break-word bg-cyan-100 text-gray-800 px-1 py-4 text-[11px] leading-tight sm:px-5 sm:py-5 sm:text-base">Velocity<br class="sm:hidden" /> Developer</th>
						<th class="bg-slate-800 px-1 py-4 text-[11px] leading-tight text-white sm:px-5 sm:py-5 sm:text-base">Jasa Lain</th>
					</tr>
				</thead>
				<tbody>
					{featureRows.map((row, index) => (
						<tr class={index % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
							<td class="wrap-break-word border-t border-slate-200 px-3 py-4 text-left text-xs font-semibold leading-relaxed text-slate-700 sm:px-5 sm:text-base">{row[0]}</td>
							<td class="border-t border-slate-200 px-1 py-4 sm:px-5">
								<span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-green-100 text-green-600 sm:h-8 sm:w-8">
									<svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 10 3 3 7-7"></path></svg>
								</span>
							</td>
							<td class="wrap-break-word border-t border-slate-200 px-1 py-4 text-[11px] font-semibold leading-tight text-slate-600 sm:px-5 sm:text-base">
								{row[2] === false ? (
									<span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-rose-100 text-rose-600 sm:h-8 sm:w-8">
										<svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
									</span>
								) : row[2]}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<div class="mt-10 text-center">
			<Button link="#" className="cta-modal-formorder w-full px-6 py-4 text-sm font-bold shadow-lg sm:w-auto sm:px-10 sm:text-base" color="yellow">Pilih Velocity untuk Bisnis Rental Saya</Button>
		</div>
	</div>
</section>
