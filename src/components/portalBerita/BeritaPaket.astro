---

<section id="paketweb" class="bg-linear-to-r from-blue-800 to-sky-600 px-6 pb-20 pt-15 text-white md:px-10">
	<div class="mx-auto max-w-6xl">
		<h2 class="mb-5 text-center text-xl font-medium md:text-2xl">
			Paket Portal Berita Profesional
		</h2>
		<div class="text-center text-2xl font-medium tracking-tighter text-rose-300 line-through mb-2">
			Rp 5.000.000
		</div>
		<div class="text-center text-5xl font-bold tracking-tighter text-yellow-400 md:text-7xl mb-4">
			Rp 3.000.000
		</div>
		<p class="mt-2 text-center text-lg text-blue-100 max-w-2xl mx-auto">
			Cukup mulai dari Rp 3 Juta untuk punya portal berita profesional dengan semua fitur lengkap!
		</p>

		<!-- Countdown Timer -->
		<div class="text-center mt-8 mb-12">
			<p class="text-xl font-bold mb-4 text-yellow-200">
				⏰ Promo Berakhir Dalam:
			</p>
			<div class="flex justify-center gap-4 flex-wrap" x-data="{
				days: '00',
				hours: '00',
				minutes: '00',
				seconds: '00',
				targetDate: new Date().setDate(new Date().getDate() + 7),
				updateCountdown() {
					const now = new Date().getTime();
					const distance = this.targetDate - now;
					
					if (distance < 0) {
						this.days = '00';
						this.hours = '00';
						this.minutes = '00';
						this.seconds = '00';
						return;
					}
					
					this.days = Math.floor(distance / (1000 * 60 * 60 * 24)).toString().padStart(2, '0');
					this.hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)).toString().padStart(2, '0');
					this.minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)).toString().padStart(2, '0');
					this.seconds = Math.floor((distance % (1000 * 60)) / 1000).toString().padStart(2, '0');
				},
				init() {
					this.updateCountdown();
					setInterval(() => this.updateCountdown(), 1000);
				}
			}" x-init="init">
				<div class="bg-white/20 backdrop-blur-sm rounded-xl p-4 min-w-[90px] shadow-lg">
					<div class="text-4xl font-bold text-yellow-300" x-text="days"></div>
					<div class="text-sm text-blue-100 mt-1">Hari</div>
				</div>
				<div class="bg-white/20 backdrop-blur-sm rounded-xl p-4 min-w-[90px] shadow-lg">
					<div class="text-4xl font-bold text-yellow-300" x-text="hours"></div>
					<div class="text-sm text-blue-100 mt-1">Jam</div>
				</div>
				<div class="bg-white/20 backdrop-blur-sm rounded-xl p-4 min-w-[90px] shadow-lg">
					<div class="text-4xl font-bold text-yellow-300" x-text="minutes"></div>
					<div class="text-sm text-blue-100 mt-1">Menit</div>
				</div>
				<div class="bg-white/20 backdrop-blur-sm rounded-xl p-4 min-w-[90px] shadow-lg">
					<div class="text-4xl font-bold text-yellow-300" x-text="seconds"></div>
					<div class="text-sm text-blue-100 mt-1">Detik</div>
				</div>
			</div>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-8 md:mt-16 md:grid-cols-2 lg:grid-cols-3">
			{packageBenefits.map((item) => (
				<div class="bg-white/10 backdrop-blur-sm p-6 rounded-2xl border border-white/20 hover:bg-white/20 transition-all duration-300 hover:shadow-lg">
					<div class="mb-4" set:html={item.icon}></div>
					<h3 class="font-bold text-xl mb-2 text-yellow-200">
						{item.title}
					</h3>
					<p class="text-sm text-blue-100">
						{item.description}
					</p>
				</div>
			))}
		</div>

		<div class="mt-16 text-center">
			<Button link="#" className="cta-modal-formorder px-16 py-5 text-xl font-bold shadow-lg hover:shadow-xl transition-shadow" color="yellow">
				<div class="flex items-center justify-center gap-3">
					Ambil Promo Sekarang - Konsultasi Gratis!
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
						<path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8" />
					</svg>
				</div>
			</Button>
		</div>
	</div>
</section>
