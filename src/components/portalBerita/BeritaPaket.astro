const packageBenefits = [
	{
		title: 'Portal Berita Siap Online',
		description: 'Cocok untuk media lokal, komunitas, organisasi, atau bisnis yang ingin punya kanal publikasi sendiri.',
		icon: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-newspaper text-yellow-400" viewBox="0 0 16 16"><path d="M0 2.5A1.5 1.5 0 0 1 1.5 1h11A1.5 1.5 0 0 1 14 2.5v10.528c0 .3-.05.654-.238.972h.738a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 1 1 0v9a1.5 1.5 0 0 1-1.5 1.5H1.497A1.497 1.497 0 0 1 0 13.5zM12 14c.37 0 .654-.211.853-.441.092-.106.147-.279.147-.531V2.5a.5.5 0 0 0-.5-.5h-11a.5.5 0 0 0-.5.5v11c0 .278.223.5.497.5z"/><path d="M2 3h10v2H2zm0 3h4v3H2zm5 0h5v1H7zm0 2h5v1H7zm-5 2h10v1H2zm0 2h10v1H2z"/></svg>'
