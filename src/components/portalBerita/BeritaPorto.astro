---
import { Image } from 'astro:assets';
import Imgmediabhayangkaranasional from '../../assets/porto-portalberita/mediabhayangkaranasional.com.webp';
import ImgKabarprimaCom from '../../assets/porto-portalberita/kabarprima.com.webp';
import ImgSuaraupdateCo from '../../assets/porto-portalberita/suaraupdate.co.webp';
import ImgBioztvId from '../../assets/porto-portalberita/bioztv.id.webp';
import ImgHaluanberitarakyatCom from '../../assets/porto-portalberita/haluanberitarakyat.com.webp';
import ImgDeliklapanCom from '../../assets/porto-portalberita/deliklapan.com.webp';
import ImgTvkomaId from '../../assets/porto-portalberita/tvkoma.id.webp';
import ImgKaltengDailyCom from '../../assets/porto/kaltengdaily.com.webp';
const items = [
    {
        title: 'mediabhayangkaranasional.com',
        image: Imgmediabhayangkaranasional
    },
    {
        title: 'kabarprima.com',
        image: ImgKabarprimaCom
    },
    {
        title: 'suaraupdate.co',
        image: ImgSuaraupdateCo
    },
    {
        title: 'bioztv.id',
        image: ImgBioztvId
    },
    {
        title: 'haluanberitarakyat.com',
        image: ImgHaluanberitarakyatCom
    },
    {
        title: 'deliklapan.com',
        image: ImgDeliklapanCom
    },
    {
        title: 'tvkoma.id',
        image: ImgTvkomaId
    },
    {
        title: 'kaltengdaily.com',
        image: ImgKaltengDailyCom
    },
]

const carouselItems = [
    items[items.length - 2],
    items[items.length - 1],
    ...items,
    items[0],
    items[1],
]

---
<div id="porto" class="lp-porto-carousel py-20 md:pt-0 px-4 max-w-360 mx-auto">
        
    <div class="swiper mySwiper">
        <div class="swiper-wrapper">
        {items.map((item, index) => (
            <div class="swiper-slide pb-2">
                <div class="carousel-cell-container relative">
                    <Image src={item.image} alt={item.title} loading="lazy" class="w-full object-contain shadow-md"/>
                    <div class="caption absolute bottom-0 left-0 right-0 pb-1 px-1 text-center text-sm transition-all duration-300">                        
                        <div class="bg-blue-600 rounded-full text-white p-2 shadow-md">
                            {item.title}
                        </div>
                    </div>
                </div>
            </div>
        ))}
  </div>
</div>


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>


<script type="module">        
    import Swiper from 'https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.mjs'
    var swiper = new Swiper(".mySwiper", {
        effect: "coverflow",
        grabCursor: false,
        centeredSlides: true,
        slidesPerView: "auto",
        coverflowEffect: {
            rotate: 0,
            stretch: 0,
            modifier: 1,
            slideShadows: true,
        },
        autoplay: {
            delay: 3000,
            disableOnInteraction: false,
        },
        loop: true,
        breakpoints: {
            640: {
                slidesPerView: 2,
                spaceBetween: 10,
                coverflowEffect: {
                    depth: 100,
                }
            },
            768: {
                slidesPerView: 3,
                spaceBetween: 30,
                coverflowEffect: {
                    depth: 300,
                }
            },
        },
    });
</script>

<style>
    .mySwiper:not(.swiper-coverflow.swiper-3d) {
        opacity: 0;
    }
    .mySwiper .swiper-slide:not(.swiper-slide-active) .caption {
        opacity: 0;
        transform: translateY(150%);
    }
    .mySwiper .swiper-slide:not(.swiper-slide-active) img {
        filter: grayscale(70%);
    }
</style>
