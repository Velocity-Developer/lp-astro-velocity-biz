---

<section id="paketweb" class="px-6 md:px-10 pt-30 pb-30 text-white bg-linear-to-r from-blue-800 to-sky-600">

    <div class="mx-auto max-w-4xl">
        <h2 class="text-center font-medium text-xl mb-5">
            Harga Promo Bulan ini
        </h2>
        <div class="text-5xl md:text-6xl font-bold text-yellow-300 tracking-tighter text-center">
            Rp 3.000.000
        </div>
        <div class="text-2xl font-medium text-rose-400 tracking-tighter text-center line-through">
            Rp 5.000.000
        </div>
        <p class="text-base md:text-md text-center mt-8 text-blue-200">
        Dapatkan Harga Spesial Khusus Bulan ini hanya dengan 3jt sudah dapat website all in one service.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-15 md:mt-25">
            {benefits.map((item) => (
                <div class="flex gap-5 md:gap-8">
                    <div>
                        <span set:html={item.icon} class="w-25 h-25"></span>
                    </div>
                    <div>
                        <h3 class="font-bold text-base md:text-2xl">
                            {item.title}
                        </h3>
                        <p class="text-xs md:text-sm text-blue-100">
                            {item.description}
                        </p>
                    </div>
                </div>
            ))}
        </div>

    
        <div class="text-center mt-10">
            <Button link="/lp#formorder" color="yellow" className="cta-modal-formorder px-20! py-4!">
                Hubungi Kami
            </Button>
        </div>


    </div>
</section>
