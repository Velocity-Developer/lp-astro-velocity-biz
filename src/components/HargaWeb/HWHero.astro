---
import { Image } from 'astro:assets';
import velocityLogo from '../../assets/velocity-logo-blue.webp';
---

<div class="min-h-100 bg-linear-to-b from-sky-100 to-orange-50 py-15 xl:py-20 px-8 text-center flex flex-col items-center justify-center">
    <div>
        <Image src={velocityLogo} alt="Velocity Developer" class="w-30 mb-6" />
    </div>
    <h1 class="text-2xl md:text-4xl font-bold text-gray-900 mb-4">
        Harga Website
    </h1>
    <p class="text-sm md:text-base text-gray-600">
        Jasa Pembuatan Website, Profile, Toko Online, Sekolah, Berita
    </p>
</div>