---
import { Image } from 'astro:assets';
import velocityLogo from '../../assets/velocity-logo-blue.webp';
---

<div class="relative min-h-100 overflow-hidden py-15 xl:py-20 px-8 text-center flex flex-col items-center justify-center bg-linear-to-b from-sky-300 via-sky-100 to-orange-50">
    
    <div class="absolute w-60 h-60 translate-y-25 translate-x-25 inset-x-0 top-0 z-1 bg-linear-to-b from-sky-200 via-sky-50 to-orange-100 rounded-full"></div>

    <div class="relative z-10 text-center">
        <Image src={velocityLogo} alt="Velocity Developer" class="w-30 mb-6 md:mb-10 mx-auto" />
        <h1 class="text-2xl md:text-4xl xl:text-6xl font-bold text-gray-900 mb-4 md:mb-6">
            Harga Website
        </h1>
        <p class="text-sm xl:text-base text-gray-600">
            Temukan solusi website sesuai dengan kebutuhan.<br>Paket lengkap dari domain, design dan hosting.
        </p>
    </div>
</div>