---
import daftarHarga from '../../data/harga.json';

const categories = daftarHarga.categories;

const formatRupiah = (price: number) =>
    new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0,
    }).format(price);

const getCategoryId = (index: number) => `paketweb-${index + 1}`;

const lastCategoryIndex = categories.length - 1;

const getPackageGridClass = (packageCount: number) => {
    if (packageCount === 1) {
        return 'md:grid-cols-1 max-w-md mx-auto';
    }

    if (packageCount === 2) {
        return 'md:grid-cols-2 max-w-4xl mx-auto';
    }

    return 'md:grid-cols-2 lg:grid-cols-3';
};
---
<div
    id="paketweb"
    class="price-container relative max-w-6xl mx-auto p-4 md:pt-30 pb-40"
    x-data={`{
        activeTab: 0,
        setTab(index) {
            this.activeTab = index;
            history.replaceState(null, '', '#paketweb-' + (index + 1));
        },
        init() {
            const match = window.location.hash.match(/^#paketweb-(\\d+)$/);

            if (!match) return;

            const tabIndex = Number(match[1]) - 1;
            this.activeTab = Math.min(Math.max(tabIndex, 0), ${lastCategoryIndex});
        }
    }`}
>

    <div class="relative z-2 grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="lg:col-span-3">
            <div class="flex gap-2 overflow-x-auto rounded-xl bg-slate-100 p-2 shadow-inner lg:sticky lg:top-28 lg:flex-col lg:overflow-visible" role="tablist">
            {categories.map((category, index) => (
                <button
                    id={`tab-${getCategoryId(index)}`}
                    type="button"
                    role="tab"
                    aria-controls={getCategoryId(index)}
                    @click={`setTab(${index})`}
                    :aria-selected={`activeTab === ${index}`}
                    :class={`activeTab === ${index} ? 'bg-sky-600 text-white shadow-sm' : 'bg-white text-slate-700 hover:bg-slate-800 hover:text-white'`}
                    class="shrink-0 rounded-lg px-4 py-2 text-left text-sm font-medium transition duration-300 lg:w-full"
                >
                    {category.category}
                </button>
            ))}
            </div>
        </div>
        <div class="relative lg:col-span-9">
        {categories.map((category, index) => (
            <div
                id={getCategoryId(index)}
                class="relative z-2"
                role="tabpanel"
                aria-labelledby={`tab-${getCategoryId(index)}`}
                x-show={`activeTab === ${index}`}
                x-cloak
            >
                <h2 class="mb-2 text-center font-bold text-2xl md:text-2xl">
                    {category.category}
                </h2>
                <p class="text-center text-sm text-gray-700">
                    {category.description}
                </p>
                <div class:list={[
                    'relative z-2 grid grid-cols-1 mt-10 gap-4 md:gap-8',
                    getPackageGridClass(category.packages.length),
                ]}>
                    {category.packages.map((item) => (
                        <div class="bg-white shadow-sm hover:shadow-xl rounded-xl overflow-hidden transition duration-300 group">
                            <div class="bg-linear-to-br from-blue-500 to-cyan-500 text-yellow-200 group-hover:bg-blue-600 group-hover:from-blue-400 transition duration-300">
                                <div class="px-3 py-5 text-center text-2xl tracking-wide font-bold">
                                    {item.name}
                                </div>
                            </div>
                            <div class="bg-white min-h-50 text-sm md:text-base">   
                                <div class="px-4 py-4 text-center odd:bg-slate-50">
                                    <div class="text-2xl md:text-3xl font-bold tracking-tighter">
                                        {formatRupiah(item.price)}
                                    </div>
                                    <div class="text-sm md:text-base mt-1 font-medium text-teal-600">
                                        {formatRupiah(item.price_extension)} /tahun
                                    </div>
                                </div>
                                <div class="px-4 py-4 text-center odd:bg-slate-50">
                                    {item.design}
                                </div>
                                <div class="px-4 py-4 text-center odd:bg-slate-50">
                                    Domain {item.domain} tahun
                                </div>
                                <div class="px-4 py-4 text-center odd:bg-slate-50">
                                    Hosting {item.hosting}
                                </div>
                                <div class="px-4 py-4 text-center odd:bg-slate-50">
                                    Bandwidth {item.bandwidth}
                                </div>
                                {item.features.map((feature) => (
                                    <div class="px-4 py-4 text-center odd:bg-slate-50 font-normal">
                                        {feature}
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>               
                
            </div>
        ))}
        </div>
    </div>

    <div class="absolute bottom-0 right-0 w-80 h-80 -translate-y-25 translate-x-0 z-1 bg-linear-to-b from-sky-200 via-sky-50 to-orange-100 rounded-full"></div>

</div>

<style>
    [x-cloak] {
        display: none !important;
    }
</style>
