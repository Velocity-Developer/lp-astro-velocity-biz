---
import daftarHarga from '../../data/harga.json';
---
<div class="price-container max-w-6xl mx-auto p-4 md:pt-10 pb-50">

    <div class="grid grid-cols-1 md:grid-cols-10 gap-8">
        <div class="md:col-span-10 pb-10 md:pb-20">
            <div class="flex flex-wrap justify-center gap-2">
            {daftarHarga.map((paket) => (
                <a href={'#paketweb-'+paket.id.toString()} class="bg-slate-800 hover:bg-sky-600 text-sm text-white px-5 py-2 shadow-sm rounded-xl transition duration-500">
                    Website {paket.title}
                </a>
            ))}
            </div>
        </div>
        <div class="md:col-span-10 space-y-20">
        {daftarHarga.map((paket) => (
            <div id={'paketweb-'+paket.id.toString()}>
                <h3 class="mb-2 text-center font-medium text-2xl">
                    {paket.title}
                </h3>
                <p class="text-center text-sm text-gray-500">
                    {paket.description}
                </p>
                <div class="grid grid-cols-3 mt-10 gap-4 md:gap-8">
                    {paket.items.map((item) => (
                        <div class="bg-white shadow-sm rounded-xl overflow-hidden transition duration-100">
                            <div class="px-3 py-3 bg-blue-100 text-sky-800 text-center text-xl font-bold">
                                {item.title}
                            </div>
                            <div class="p-4 bg-white min-h-50">                                
                                {Object.entries(item).map(([key, value]) => (
                                    {value}
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        ))}
        </div>
    </div>

</div>