---
const problems = [
    'Harga awal murah, tapi banyak biaya tambahan',
    'Hosting dibatasi kapasitas kecil',
    'Jumlah halaman dibatasi',
    'Sulit meminta revisi',
    'Setelah website selesai, support menghilang'    
]

const benefits = [
    'Hosting Unlimited',
    'Halaman Unlimited',
    'Domain Gratis',
    'Support Tanya Jawab Selamanya',
    'Panduan Kelola Website',
    'Desain Profesional Custom',
    '✓Garansi perbaikan jika web rusak',
    '✓ Email Bisnis',
]
import Button from '../components/Button.astro';
---
<section id="painpoint" class="w-full bg-slate-900 text-white py-15 xl:py-20 px-8">
    <div class="mx-auto max-w-2xl">

        <h2 class="text-center font-bold text-2xl md:text-3xl mb-6 md:mb-10 mx-auto max-w-2xl">
            Pernah Mengalami Hal Ini Saat Membuat Website?
        </h2>

        <ul class="list-inside text-base md:text-xl space-y-2">
            {problems.map((problem) => (
                <li>
                    ❌ {problem}
                </li>
            ))}
        </ul>

        
        <h3 class="text-center font-bold text-xl md:text-2xl mt-15 mb-6 md:mb-10 mx-auto max-w-2xl">
           Di Velocity Developer Hanya dengan <span class="text-yellow-400 text-3xl md:text-4xl">3 Juta</span> saja sudah mendapatkan all in one service:
        </h3>
        <ul class="list-inside text-base md:text-xl space-y-2">
            {benefits.map((benefit) => (
                <li>
                    ✅ {benefit}
                </li>
            ))}
        </ul>

        
        <div class="text-center mt-10">                       
            <Button link="/lp#formorder" color="yellow">                
                <div class="flex justify-center items-center gap-2">
                    Hubungi Kami
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-right" viewBox="0 0 16 16"> <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/> </svg>
                    
                </div>
            </Button>
        </div>

    </div>
</section>