---
const faqs = [
	['Berapa lama proses pembuatan portal berita?', 'Umumnya 3 sampai 10 hari kerja, tergantung kelengkapan materi, kebutuhan revisi, dan fitur tambahan yang ingin disiapkan.'],
	['Apakah portal berita ini sudah siap upload artikel sendiri?', 'Ya. Anda mendapatkan dashboard admin untuk posting berita, mengatur kategori, edit halaman, dan mengelola konten tanpa coding.'],
	['Apakah ada biaya langganan?', 'Ada. Biaya paket mulai Rp 390rb untuk masa aktif 1 tahun. Biaya perpanjangan menyesuaikan paket yang dipilih.'],
	['Apakah bisa dibantu setting monetisasi dan slot iklan?', 'Bisa. Struktur portal disiapkan agar mudah dipasang area iklan, banner sponsor, dan kebutuhan monetisasi seperti AdSense.'],
	['Apakah website-nya SEO ready dan bisa diarahkan ke Google News?', 'Portal dibangun dengan struktur yang rapi, cepat, dan ramah SEO. Kami juga membantu setup dasar untuk kebutuhan Google News.'],
	['Apakah ada support setelah website selesai?', 'Ya. Kami tetap membantu kebutuhan teknis, panduan penggunaan, dan kendala umum setelah portal diluncurkan.'],
	['Kalau saya belum punya nama media atau konsepnya, apakah tetap bisa konsultasi?', 'Tetap bisa. Konsultasi awal dapat membahas konsep media, target pembaca, struktur kategori, dan kebutuhan sebelum produksi.']
];

const orderUrl = '/order-web?category=Website+Berita+%2F+Media+Online';
---

<section id="faq" class="bg-linear-to-b from-white to-blue-50 px-6 py-16 md:px-10 md:py-24">
	<div class="mx-auto max-w-5xl">
		<div class="mx-auto max-w-3xl text-center">
			<div class="mb-3 inline-flex rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-800">FAQ Paket Berita</div>
			<h2 class="text-3xl font-bold text-slate-900 md:text-5xl">Pertanyaan yang sering ditanyakan sebelum order</h2>
			<p class="mt-4 text-base text-slate-600 md:text-lg">Jawaban singkat untuk pertanyaan yang paling sering muncul dari calon owner media online.</p>
		</div>
		<div class="mt-10 space-y-4" x-data="{ open: 0 }">
			{faqs.map(([question, answer], index) => (
				<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md">
					<button type="button" class="flex w-full items-center justify-between gap-4 px-6 py-5 text-left text-slate-800" @click={`open === ${index} ? open = null : open = ${index}`} x-bind:aria-expanded={`(open === ${index}).toString()`}>
						<span class="text-base font-semibold md:text-lg">{question}</span>
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-100 text-xl font-bold text-blue-700" x-text={`open === ${index} ? '−' : '+'`}></span>
					</button>
					<div x-show={`open === ${index}`} x-transition class="px-6 pb-6 text-sm leading-7 text-slate-600 md:text-base">{answer}</div>
				</div>
			))}
		</div>
		<div class="mt-10 rounded-3xl bg-blue-900 px-6 py-8 text-center text-white shadow-xl">
			<h3 class="text-2xl font-bold md:text-3xl">Masih ada pertanyaan sebelum mulai?</h3>
			<p class="mt-3 text-blue-100 md:text-lg">Isi form konsultasi dan kami bantu cek kebutuhan portal berita Anda tanpa biaya.</p>
			<a href={orderUrl} class="mt-6 inline-flex rounded-full bg-yellow-400 px-8 py-4 font-bold text-slate-900" onclick="if (typeof window.fbq === 'function') window.fbq('track', 'Lead');">Order Portal Berita Sekarang</a>
		</div>
	</div>
</section>
