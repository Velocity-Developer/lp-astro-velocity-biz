---
import { Image } from 'astro:assets';
import ImgPartnerLegal from '../assets/porto/partnerlegal.id.webp';
import ImgKaltengDailyCom from '../assets/porto/kaltengdaily.com.webp';
import ImgTiketGoyCom from '../assets/porto/tiketgoy.com.webp';
import ImgFahmitourCom from '../assets/porto/fahmitour.com.webp';
import ImgPrimadutatourCom from '../assets/porto/primadutatour.com.webp';
import ImgLetsexExploreIndonesiaCom from '../assets/porto/letsexploreindonesia.com.webp';
import ImgZehntenMassageCom from '../assets/porto/zehnten-massage.ch.webp';
import ImgSumberanekametalCom from '../assets/porto/sumberanekametal.com.webp';
import ImgDemondhygieneklinieknlCom from '../assets/porto/demondhygienekliniek.nl.webp';
import ImgGolkarlamonganCom from '../assets/porto/golkarlamongan.com.webp';
const items = [
    {
        title: 'letsexploreindonesia.com',
        image: ImgLetsexExploreIndonesiaCom
    },
    {
        title: 'demondhygienekliniek.nl',
        image: ImgDemondhygieneklinieknlCom
    },
    {
        title: 'zehnten-massage.ch',
        image: ImgZehntenMassageCom
    },
    {
        title: 'partnerlegal.id',
        image: ImgPartnerLegal
    },
    {
        title: 'kaltengdaily.com',
        image: ImgKaltengDailyCom
    },
    {
        title: 'tiketgoy.com',
        image: ImgTiketGoyCom
    },
    {
        title: 'fahmitour.com',
        image: ImgFahmitourCom
    },
    {
        title: 'primadutatour.com',
        image: ImgPrimadutatourCom
    },
    {
        title: 'sumberanekametal.com',
        image: ImgSumberanekametalCom
    },
    {
        title: 'golkarlamongan.com',
        image: ImgGolkarlamonganCom
    },
]

const carouselItems = [
    items[items.length - 2],
    items[items.length - 1],
    ...items,
    items[0],
    items[1],
]

---
<div id="porto" class="lp-porto-carousel py-20 md:pt-0 px-4 max-w-360 mx-auto" data-porto-carousel>
        
    <div class="swiper mySwiper">
        <div class="swiper-wrapper">
        {items.map((item, index) => (
            <div class="swiper-slide pb-2">
                <div class="carousel-cell-container relative">
                    <Image src={item.image} alt={item.title} loading="lazy" class="w-full object-contain shadow-md"/>
                    <div class="caption absolute bottom-0 left-0 right-0 pb-1 px-1 text-center text-sm transition-all duration-300">                        
                        <div class="bg-blue-600 rounded-full text-white p-2 shadow-md">
                            {item.title}
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>
  </div>
</div>


<script>
    const root = document.querySelector<HTMLDivElement>('[data-porto-carousel]');
    const swiperElement = root?.querySelector<HTMLDivElement>('.mySwiper');

    async function initSwiper() {
        if (!root || !swiperElement || root.dataset.swiperInitialized === 'true') {
            return;
        }

        root.dataset.swiperInitialized = 'true';

        const [{ default: Swiper }, { Autoplay, EffectCoverflow }] = await Promise.all([
            import('swiper'),
            import('swiper/modules'),
        ]);

        new Swiper(swiperElement, {
            modules: [Autoplay, EffectCoverflow],
            effect: 'coverflow',
            grabCursor: false,
            centeredSlides: true,
            slidesPerView: 1.15,
            spaceBetween: 16,
            coverflowEffect: {
                rotate: 0,
                stretch: 0,
                depth: 120,
                modifier: 1,
                slideShadows: true,
                scale: 0.92,
            },
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
                pauseOnMouseEnter: true,
            },
            loop: true,
            breakpoints: {
                640: {
                    slidesPerView: 2,
                    spaceBetween: 16,
                    coverflowEffect: {
                        depth: 160,
                    },
                },
                768: {
                    slidesPerView: 3,
                    spaceBetween: 24,
                    coverflowEffect: {
                        depth: 240,
                    },
                },
            },
        });

        root.dataset.swiperReady = 'true';
    }

    if (root && swiperElement) {
        const observer = new IntersectionObserver((entries) => {
            const [entry] = entries;

            if (!entry?.isIntersecting) {
                return;
            }

            observer.disconnect();
            initSwiper().catch(() => {
                root.dataset.swiperInitialized = 'false';
            });
        }, {
            rootMargin: '300px 0px',
        });

        observer.observe(root);
    }
</script>

<style>
    .mySwiper {
        overflow-x: auto;
        padding-block: 1rem;
        scrollbar-width: none;
    }

    .mySwiper::-webkit-scrollbar {
        display: none;
    }

    .mySwiper .swiper-wrapper {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(82%, 1fr);
        gap: 1rem;
        align-items: center;
        scroll-snap-type: x mandatory;
    }

    .mySwiper .swiper-slide {
        scroll-snap-align: center;
    }

    .mySwiper .caption {
        opacity: 1;
        transform: translateY(0);
    }

    .mySwiper img {
        filter: none;
    }

    [data-swiper-ready="true"] .mySwiper:not(.swiper-coverflow.swiper-3d) {
        opacity: 0;
    }

    [data-swiper-ready="true"] .mySwiper {
        overflow: hidden;
        padding-block: 0;
    }

    [data-swiper-ready="true"] .mySwiper .swiper-wrapper {
        display: flex;
        gap: 0;
        align-items: stretch;
        scroll-snap-type: none;
        transition-property: transform;
        box-sizing: content-box;
    }

    [data-swiper-ready="true"] .mySwiper .swiper-slide {
        flex-shrink: 0;
        width: 100%;
        height: 100%;
        position: relative;
        transition-property: transform;
        display: block;
        scroll-snap-align: unset;
    }

    [data-swiper-ready="true"] .mySwiper.swiper-3d {
        perspective: 1200px;
    }

    [data-swiper-ready="true"] .mySwiper.swiper-3d .swiper-wrapper {
        transform-style: preserve-3d;
    }

    [data-swiper-ready="true"] .mySwiper.swiper-3d .swiper-slide,
    [data-swiper-ready="true"] .mySwiper.swiper-3d .swiper-slide-shadow-left,
    [data-swiper-ready="true"] .mySwiper.swiper-3d .swiper-slide-shadow-right {
        transform-style: preserve-3d;
    }

    [data-swiper-ready="true"] .mySwiper .swiper-slide-shadow-left,
    [data-swiper-ready="true"] .mySwiper .swiper-slide-shadow-right {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 10;
    }

    [data-swiper-ready="true"] .mySwiper .swiper-slide-shadow-left {
        background-image: linear-gradient(to left, rgba(0, 0, 0, 0.5), transparent);
    }

    [data-swiper-ready="true"] .mySwiper .swiper-slide-shadow-right {
        background-image: linear-gradient(to right, rgba(0, 0, 0, 0.5), transparent);
    }

    [data-swiper-ready="true"] .mySwiper .swiper-slide:not(.swiper-slide-active) .caption {
        opacity: 0;
        transform: translateY(150%);
    }

    [data-swiper-ready="true"] .mySwiper .swiper-slide:not(.swiper-slide-active) img {
        filter: grayscale(70%);
    }

    @media screen and (min-width: 640px) {
        .mySwiper .swiper-wrapper {
            grid-auto-columns: minmax(48%, 1fr);
        }
    }

    @media screen and (min-width: 768px) {
        .mySwiper .swiper-wrapper {
            grid-auto-columns: minmax(31%, 1fr);
        }
    }
</style>
