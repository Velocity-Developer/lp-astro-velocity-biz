---
import { Image } from 'astro:assets';
import 'swiper/css';
import 'swiper/css/effect-coverflow';
import ImgPartnerLegal from '../assets/porto/partnerlegal.id.webp';
import ImgKaltengDailyCom from '../assets/porto/kaltengdaily.com.webp';
import ImgTiketGoyCom from '../assets/porto/tiketgoy.com.webp';
import ImgFahmitourCom from '../assets/porto/fahmitour.com.webp';
import ImgPrimadutatourCom from '../assets/porto/primadutatour.com.webp';
import ImgLetsexExploreIndonesiaCom from '../assets/porto/letsexploreindonesia.com.webp';
import ImgZehntenMassageCom from '../assets/porto/zehnten-massage.ch.webp';
import ImgSumberanekametalCom from '../assets/porto/sumberanekametal.com.webp';
import ImgDemondhygieneklinieknlCom from '../assets/porto/demondhygienekliniek.nl.webp';
import ImgGolkarlamonganCom from '../assets/porto/golkarlamongan.com.webp';
const items = [
    {
        title: 'letsexploreindonesia.com',
        image: ImgLetsexExploreIndonesiaCom
    },
    {
        title: 'demondhygienekliniek.nl',
        image: ImgDemondhygieneklinieknlCom
    },
    {
        title: 'zehnten-massage.ch',
        image: ImgZehntenMassageCom
    },
    {
        title: 'partnerlegal.id',
        image: ImgPartnerLegal
    },
    {
        title: 'kaltengdaily.com',
        image: ImgKaltengDailyCom
    },
    {
        title: 'tiketgoy.com',
        image: ImgTiketGoyCom
    },
    {
        title: 'fahmitour.com',
        image: ImgFahmitourCom
    },
    {
        title: 'primadutatour.com',
        image: ImgPrimadutatourCom
    },
    {
        title: 'sumberanekametal.com',
        image: ImgSumberanekametalCom
    },
    {
        title: 'golkarlamongan.com',
        image: ImgGolkarlamonganCom
    },
]

const carouselItems = [
    items[items.length - 2],
    items[items.length - 1],
    ...items,
    items[0],
    items[1],
]

---
<div id="porto" class="lp-porto-carousel py-20 md:pt-0 px-4 max-w-360 mx-auto">
        
    <div class="swiper mySwiper">
        <div class="swiper-wrapper">
        {items.map((item, index) => (
            <div class="swiper-slide pb-2">
                <div class="carousel-cell-container relative">
                    <Image src={item.image} alt={item.title} loading="lazy" class="w-full object-contain shadow-md"/>
                    <div class="caption absolute bottom-0 left-0 right-0 pb-1 px-1 text-center text-sm transition-all duration-300">                        
                        <div class="bg-blue-600 rounded-full text-white p-2 shadow-md">
                            {item.title}
                        </div>
                    </div>
                </div>
            </div>
        ))}
  </div>
</div>


<script>
    import Swiper from 'swiper';
    import { Autoplay, EffectCoverflow } from 'swiper/modules';

    new Swiper('.mySwiper', {
        modules: [Autoplay, EffectCoverflow],
        effect: 'coverflow',
        grabCursor: false,
        centeredSlides: true,
        slidesPerView: 1.15,
        spaceBetween: 16,
        coverflowEffect: {
            rotate: 0,
            stretch: 0,
            depth: 120,
            modifier: 1,
            slideShadows: true,
            scale: 0.92,
        },
        autoplay: {
            delay: 3000,
            disableOnInteraction: false,
            pauseOnMouseEnter: true,
        },
        loop: true,
        breakpoints: {
            640: {
                slidesPerView: 2,
                spaceBetween: 16,
                coverflowEffect: {
                    depth: 160,
                },
            },
            768: {
                slidesPerView: 3,
                spaceBetween: 24,
                coverflowEffect: {
                    depth: 240,
                },
            },
        },
    });
</script>

<style>
    .mySwiper:not(.swiper-coverflow.swiper-3d) {
        opacity: 0;
    }
    .mySwiper .swiper-slide:not(.swiper-slide-active) .caption {
        opacity: 0;
        transform: translateY(150%);
    }
    .mySwiper .swiper-slide:not(.swiper-slide-active) img {
        filter: grayscale(70%);
    }
</style>
